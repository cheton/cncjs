.display-panel {
    .coordinate {
        position: relative;
        padding: 5px 0;
        text-align: center;
        width: 1%;

        .axis {
            font-size: 24px;
        }
    }

    .machine-position,
    .work-position {
        position: relative;
        white-space: nowrap;
        padding: 0;
        width: 48%;
    }

    .action {
        width: 1%;
        padding: 0;
        text-align: center;

        button.action-dropdown {
            min-width: auto;
            border-radius: 0;

            > * {
                color: var(--tonic-colors-text-secondary);
            }

            &:disabled:hover {
                background-color: inherit;
                > * {
                    color: var(--tonic-colors-text-secondary);
                }
            }
            &:hover {
                background-color: var(--tonic-colors-actions-hovered);
                > * {
                    color: var(--tonic-colors-text-primary);
                }
            }
        }
    }
}
